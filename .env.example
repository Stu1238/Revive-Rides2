[TEMPLATE]
# Revive Rides — environment variables
#
# Copy this file to `.env` for local values. `.env` is git-ignored and
# must never be committed. On Vercel, set these in Project Settings →
# Environment Variables (server-side only — never exposed to the browser).

# Port the booking server listens on (defaults to 3000 if unset)
PORT=3000

# ---- Persistent booking store (REQUIRED IN PRODUCTION) ----
# Booking state must survive across serverless invocations and shared
# between all visitors, so it lives in Redis — not in server memory.
#
# Preferred: Upstash Redis via the Vercel Marketplace integration
# (the official successor of Vercel KV, which was sunset in Dec 2024).
# The integration injects these automatically; the same vars are read
# with either prefix:
# KV_REST_API_URL=https://example.upstash.io
# KV_REST_API_TOKEN=xxxxxxxx
#
# Alternative prefix (identical behaviour):
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx
#
# Optional alternative for self-hosting (needs `npm i --no-save redis`):
# REDIS_URL=redis://default:PASSWORD@host:6379
#
# With none of these set the server falls back to in-memory state,
# which is for LOCAL DEVELOPMENT ONLY: bookings are not shared between
# visitors and are lost on restart.
