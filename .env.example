# Revive Rides — environment variables
#
# Copy this file to `.env` for local values. `.env` is git-ignored and
# must never be committed.
#
# This project intentionally holds NO API keys or third-party secrets:
# there are no external services, no database, and no payment processing.
# The only environment variable is the server port (server.js).
#
# To load this file locally (Node 20+):
#   node --env-file=.env server.js
# Or set variables in your hosting provider's environment settings.

# Port the booking server listens on (defaults to 3000 if unset)
PORT=3000
